{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/ordini-notifica",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/ordini-notifica",
      "schedule": "0 6 * * *"
    }
  ]
}
